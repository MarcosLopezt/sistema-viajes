# ---------------------------------------------------------------------------
# Copiá este archivo a `.env` y completá los valores. `.env` está gitignoreado.
# Ningún valor real vive en este archivo.
# ---------------------------------------------------------------------------

# --- Base de datos (Supabase → Project Settings → Database) -----------------
# Pooler (pgbouncer, modo transaction, puerto 6543). La usa la app en runtime.
# Los parámetros pgbouncer=true y connection_limit=1 NO son opcionales:
# pgbouncer en modo transaction no soporta prepared statements.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Conexión directa (puerto 5432). La usan `prisma migrate` y `prisma db seed`.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase (Project Settings → API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# Bypassea RLS. SOLO en el servidor: nunca la expongas con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Bucket PRIVADO para comprobantes de pago y certificados médicos.
# Crealo en Supabase → Storage y dejalo sin acceso público.
SUPABASE_STORAGE_BUCKET="documentos"

# --- Mail --------------------------------------------------------------------
# "console" (default en desarrollo: loguea, no envía) | "brevo"
EMAIL_PROVIDER="console"
BREVO_API_KEY="<brevo-api-key>"
EMAIL_FROM_NAME="Viajes"
EMAIL_FROM_ADDRESS="no-reply@example.com"

# --- Cron --------------------------------------------------------------------
# Secreto compartido que protege POST /api/cron/daily.
# Generalo con: openssl rand -base64 32
# Vercel Cron lo manda como `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET="<random-32-bytes-base64>"

# --- App ---------------------------------------------------------------------
# URL pública. Se usa para armar los links de invitación en los mails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# NOTA: el backup semanal usa secretos de GitHub Actions, no de este archivo.
# Ver README §Backups (BACKUP_DATABASE_URL y BACKUP_PASSPHRASE).
# ---------------------------------------------------------------------------
